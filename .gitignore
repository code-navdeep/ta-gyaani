# Secrets — .env carries the live Dhan JWT and the dashboard credentials.
# Never tracked: git history preserves a committed secret even after deletion.
.env
data/.env.bak

# Python virtualenv (~279 MB, rebuilt from requirements.lock)
venv/

# Databases — regenerated by the app on boot. ohlc.db / metrics.db /
# historical.db are working artifacts, not source, and are deliberately
# deleted whenever the schema changes.
data/*.db
data/*.db-wal
data/*.db-shm

# Runtime logs
data/logs/

# DailyScheduler latch — which trading day's EOD jobs last completed.
# Per-deployment runtime state, not source. A committed copy would travel to
# another machine (or come back on a rollback) carrying someone else's date,
# and a stale FUTURE date silently suppresses that day's archive, beta
# precompute and token renewal, with no error raised.
data/daily_scheduler_state.json
data/daily_scheduler_state.json.tmp

# One-time backfill source databases (large, externally supplied)
backfill_data/

# Python / pytest build artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# macOS
.DS_Store
