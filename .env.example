# TA Gyaani settings.
# Copy this file to a file named .env in the same folder and fill in the four
# required values. .env stays on your computer: it is listed in .gitignore and
# is not built into the Docker image.

# Required — your Dhan API credentials, from your Dhan account's API settings.
# The app renews the access token by itself each trading day at 15:34 and
# writes the new one back into this file.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Required — any username and password you choose. The browser asks for them
# when you open the dashboard; the app will not start without them.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional — remove the leading # to change a default.
# Minimum seconds between two quote requests to Dhan (default 1.0).
# BASE_RATE_LIMIT_DELAY=1.0
# Seconds to wait for a busy price database before giving up (default 30.0).
# DB_TIMEOUT=30.0
# Price database page cache; a negative number is in kibibytes (default
# -64000, about 64 MB).
# DB_CACHE_SIZE=-64000
